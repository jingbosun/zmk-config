#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {

    };
                
                
                



    
    keymap {
        compatible = "zmk,keymap";

        default_layer {
        //===============================================================================================================================
        bindings = <
            // ------------------------------------------------------------------------------------------------------------
            &lt ESC         &kp N1 &kp N2 &kp N3        &kp N4   &kp N5                          &kp N6      &kp N7   &kp N8    &kp N9  &kp N0    &kp BSPC
            &lt 1 ESC       &kp Q  &kp W  &kp E         &kp R    &kp T                           &kp Y       &kp U    &kp I     &kp O   &kp P     &kp BSPC
            &mt LCTRL TAB   &kp A  &kp S  &kp D         &kp F    &kp G                           &kp H       &kp J    &kp K     &kp L   &kp COLON &kp RET
            &kp LSHFT       &kp Z  &kp X  &kp C         &kp V    &kp B  &mo 1        &lt 1 TILDE &kp N       &kp M    &kp COMMA &kp DOT &kp FSLH  &kp RSHFT
                                          &mt LALT LGUI &kp LALT &mo 1  &kp SPACE    &lt 1 LEFT  &lt 1 DOWN  &kp UP   &kp RIGHT
            // ------------------------------------------------------------------------------------------------------------
        >; };
        //===============================================================================================================================


        adjust_layer {
// ----------------------------------------------------------------------------------------------------------------------------
// | BTCLR  |  BT1    |  BT2    |   BT3   |   BT4   |   BT5   |                  |      |      |       |      |       |       |
// | EXTPWR | RGB_HUD | RGB_HUI | RGB_SAD | RGB_SAI | RGB_EFF |                  |      |      |       |      |       |       |
// |        | RGB_BRD | RGB_BRI |         |         |         |                  |      |      |       |      |       |       |
// |        |         |         |         |         |         | RGB_TOG | |      |      |      |       |      |       |       |
//                    |         |         |         |         |         | |      |      |      |       |      |
            bindings = <
&bt BT_CLR        &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4                            &trans &trans &trans &trans &trans &trans
&ext_power EP_TOG &rgb_ug RGB_HUD &rgb_ug RGB_HUI &rgb_ug RGB_SAD &rgb_ug RGB_SAI &rgb_ug RGB_EFF                         &trans &trans &trans &trans &trans &trans
&trans             &rgb_ug RGB_BRD &rgb_ug RGB_BRI &trans           &trans           &trans                                   &trans &trans &trans &trans &trans &trans
&trans             &trans           &trans           &trans           &trans           &trans            &trans &trans  &trans &trans &trans &trans &trans &trans
                                  &trans           &trans           &trans           &trans            &trans           &trans  &trans &trans &trans &trans
            >;
        };
        extra1 { status = "reserved"; };

        extra2 { status = "reserved"; };

        extra3 { status = "reserved"; };

        extra4 { status = "reserved"; };

        extra5 { status = "reserved"; };
    };
};
