

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/rgb.h>
/ {
    behaviors {
        vimsave: vimsave {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = < &kp COLON &kp W &kp RET >;
        };
        jialipc: jialipc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = < &kp N4 &kp N9 &kp N6 &kp N2 >;
        };
        dami: dami {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = < &macro_press &kp LSHFT &macro_tap &kp B &macro_release &kp LSHFT &kp U &kp Z &kp H &kp I &kp D &kp A &kp O &kp N9 &kp N7 &kp N1 &kp N0 &kp N6 &kp N2 &kp N6 &kp N2 >;
        };
        tmuxnextp: tmuxnextp {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = < &kp GRAVE &kp O >;
        };
        tmuxd: tmuxd {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = < &kp GRAVE &kp D >;
        };
        tmuxfloat: tmuxfloat {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = < &kp GRAVE &kp P >;
        };
        tmuxc: tmuxc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = < &kp GRAVE &kp C >;
        };
        tmuxx: tmuxx {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = < &kp GRAVE &kp X >;
        };
        tmuxcancel: tmuxcancel {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <
                &macro_press   &kp LCTRL
                &macro_tap     &kp LBKT
                &macro_release &kp LCTRL
            >;
        };
        tmuxwin: tmuxwin {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = < &kp GRAVE &kp S >;
        };
        tmuxcopy: tmuxcopy {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = < &kp GRAVE &kp F >;
        };
        tmuxpaste: tmuxpaste {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = < &kp GRAVE &kp RBKT >;
        };
        tmuxprep: tmuxprep {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = < &kp GRAVE &kp SEMI >;
        };
        tmuxnext: tmuxnext {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = < &kp GRAVE &kp N >;
        };
        tmuxheng: tmuxheng {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = < &kp GRAVE &kp PRCNT >;
        };
        tmuxshu: tmuxshu {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = < &kp GRAVE &kp DQT >;
        };

        zhongkuahao: zhongkuahao {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = < &kp LBKT &kp RBKT &kp LEFT >;
        };
        dakuohao: dakuohao {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = < &kp LBRC &kp RBRC &kp LEFT >;
        };
        kuohao: kuohao {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = < &kp LPAR &kp RPAR &kp LEFT >;
        };
        yinhao: yinhao {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = < &kp APOS &kp APOS &kp LEFT >;
        };
        shuangyinhao: shuangyinhao {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = < &kp DQT &kp DQT &kp LEFT >;
        };

        vimv: vimv {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = < &kp N0 &kp V &kp DLLR >;
        };
        sel1: sel1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = < &kp N1 &kp J &kp DLLR >;
        };
        sel2: sel2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = < &kp N2 &kp J &kp DLLR >;
        };
        sel3: sel3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = < &kp N3 &kp J &kp DLLR >;
        };
        sel4: sel4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = < &kp N4 &kp J &kp DLLR >;
        };
        sel5: sel5 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = < &kp N5 &kp J &kp DLLR >;
        };

        ctrljian: ctrljian {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <
                &macro_press   &kp LCTRL
                &macro_tap     &kp MINUS 
                &macro_release &kp LCTRL
            >;
        };
        ctrljia: ctrljia {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <
                &macro_press   &kp LCTRL
                &macro_tap     &kp PLUS
                &macro_release &kp LCTRL
            >;
        };


    };
                
                
                




    
    keymap {
        compatible = "zmk,keymap";

        default_layer {
        //===============================================================================================================================
        bindings = <
            // ------------------------------------------------------------------------------------------------------------
            &lt ESC         &kp N1 &kp N2 &kp N3        &kp N4   &kp N5                          &kp N6      &kp N7   &kp N8    &kp N9  &kp N0    &kp BSPC
            &lt 2 ESC       &kp Q  &kp W  &kp E         &kp R    &kp T                           &kp Y       &kp U    &kp I     &kp O   &kp P     &kp BSPC
            &mt LCTRL TAB   &kp A  &kp S  &kp D         &kp F    &kp G                           &kp H       &kp J    &kp K     &kp L   &kp COLON &kp RET
            &kp LSHFT       &kp Z  &kp X  &kp C         &kp V    &kp B  &mo 2        &lt 2 TILDE &kp N       &kp M    &kp COMMA &kp DOT &kp FSLH  &kp RSHFT
                                          &mt LALT LGUI &kp LALT &mo 1  &kp SPACE    &lt 2 LEFT  &lt 2 DOWN  &kp UP   &kp RIGHT
            // ------------------------------------------------------------------------------------------------------------
        >; };
        //===============================================================================================================================


        LAYER_1 {
        bindings = <
            // ------------------------------------------------------------------------------------------------------------
            &kp GRAVE   &kp EXCL  &kp AT       &kp HASH         &kp DLLR   &kp PRCNT                          &kp CARET    &kp AMPS   &kp STAR   &kp LPAR  &kp RPAR  &kp BSPC
            &kp ESC     &kp N1    &kp N2       &kp N3           &kp N4     &kp N5                             &kp N6       &kp N7     &kp N8     &kp N9    &kp N0    &kp BSPC
            &kp LCTRL   &kp EXCL  &vimsave     &kp HASH         &kp DLLR   &kp PRCNT                          &kp PLUS     &kp EQUAL  &kp MINUS  &kp STAR  &kp SEMI  &kp RET
            &kp LSHFT   &trans    &trans       &trans           &kp BSLH   &kp PIPE  &trans       &trans      &kp CARET    &kp AMPS   &kp COMMA  &kp DOT   &kp BSLH  &kp AT
                                               &trans           &jialipc   &trans    &tmuxnext    &kp MINUS   &kp UNDER    &trans     &dami
            // ------------------------------------------------------------------------------------------------------------
        >; };
        //===============================================================================================================================


        LAYER_2 {
        bindings = <
            // ------------------------------------------------------------------------------------------------------------
            &trans      &trans    &trans       &trans           &trans     &trans                                  &trans       &trans     &trans     &trans    &trans         &trans
            &kp TILDE   &vimv     &sel2        &sel3            &sel4      &sel5                                   &trans       &trans     &trans     &trans    &trans         &tmuxd
            &kp GRAVE   &trans    &trans       &trans           &trans     &yinhao                                 &tmuxheng    &trans     &trans     &trans    &trans         &tmuxc
            &trans      &trans    &trans       &trans           &trans     &shuangyinhao  &kp CAPS        &trans   &tmuxshu     &trans     &trans     &trans    &tmuxcancel    &tmuxx
                                               &trans           &dakuohao  &kuohao        &zhongkuahao    &trans   &trans       &trans     &trans
            // ------------------------------------------------------------------------------------------------------------
        >; };
        //===============================================================================================================================



        LAYER_3 {
        bindings = <
            // ------------------------------------------------------------------------------------------------------------
            &trans      &trans    &trans       &trans           &trans     &trans                              &trans       &trans     &trans     &trans    &trans        &trans
            &trans      &trans    &trans       &trans           &trans     &trans                              &trans       &trans     &trans     &trans    &tmuxpaste    &tmuxwin
            &trans      &trans    &trans       &trans           &trans     &trans                              &tmuxheng    &tmuxprep  &tmuxnextp &trans    &trans        &trans
            &trans      &trans    &trans       &trans           &trans     &trans  &trans        &trans        &tmuxshu     &trans     &trans     &trans    &trans        &trans
                                               &trans           &trans     &trans  &trans        &trans        &tmuxfloat   &trans     &trans
            // ------------------------------------------------------------------------------------------------------------
        >; };
        //===============================================================================================================================




        adjust_layer {
// ----------------------------------------------------------------------------------------------------------------------------
// | BTCLR  |  BT1    |  BT2    |   BT3   |   BT4   |   BT5   |                  |      |      |       |      |       |       |
// | EXTPWR | RGB_HUD | RGB_HUI | RGB_SAD | RGB_SAI | RGB_EFF |                  |      |      |       |      |       |       |
// |        | RGB_BRD | RGB_BRI |         |         |         |                  |      |      |       |      |       |       |
// |        |         |         |         |         |         | RGB_TOG | |      |      |      |       |      |       |       |
//                    |         |         |         |         |         | |      |      |      |       |      |
            bindings = <
&bt BT_CLR        &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4                            &trans &trans &trans &trans &trans &trans
&ext_power EP_TOG &rgb_ug RGB_HUD &rgb_ug RGB_HUI &rgb_ug RGB_SAD &rgb_ug RGB_SAI &rgb_ug RGB_EFF                         &trans &trans &trans &trans &trans &trans
&trans             &rgb_ug RGB_BRD &rgb_ug RGB_BRI &trans           &trans           &trans                                   &trans &trans &trans &trans &trans &trans
&trans             &trans           &trans           &trans           &trans           &trans            &trans &trans  &trans &trans &trans &trans &trans &trans
                                  &trans           &trans           &trans           &trans            &trans           &trans  &trans &trans &trans &trans
            >;
        };
        extra1 { status = "reserved"; };

        extra2 { status = "reserved"; };

        extra3 { status = "reserved"; };

        extra4 { status = "reserved"; };

        extra5 { status = "reserved"; };
    };
};